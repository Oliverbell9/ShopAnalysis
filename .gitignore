# ============================================================
# ShopAnalysis - Git Ignore Rules
# ============================================================

# Python virtual environments
.venv/
venv/
env/

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment variables / secrets
.env
.env.*
!.env.example

# Credentials / keys
*.pem
*.key
*.p12
*.pfx
credentials/
secrets/

# Local raw and generated data
data/raw/*
!data/raw/.gitkeep

data/parquet/*
!data/parquet/.gitkeep


data/samples/*
!data/samples/.gitkeep

# Garage local object-storage runtime data
data/garage/

# DuckDB
*.duckdb
*.duckdb.wal

# dbt generated artifacts
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Terraform generated/state files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
crash.log
crash.*.log

# Airflow runtime artifacts
airflow.db
airflow.cfg
webserver_config.py
orchestration/logs/
orchestration/airflow.db

# Jupyter
.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak

# Local test / coverage artifacts
.coverage
coverage.xml
htmlcov/

# Build/distribution
build/
dist/
*.egg-info/

# Local personal notes
Codes.txt
