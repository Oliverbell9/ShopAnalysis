# ShopAnalysis Airflow development configuration.
# Copy to .env and supply your own values.
# Do not commit the populated .env file.

AIRFLOW_POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
AIRFLOW_SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:REPLACE_WITH_LOCAL_POSTGRES_PASSWORD@postgres:5432/airflow
AIRFLOW_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
