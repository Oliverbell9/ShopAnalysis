# ============================================================
# ShopAnalysis - Environment Variable Template
# ============================================================
# Copy this file to .env for local development.
# NEVER commit the real .env file.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
SHOPANALYSIS_ENV=dev

# ------------------------------------------------------------
# AWS / S3
# ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=shopanalysis-CHANGE-ME

# ------------------------------------------------------------
# Snowflake
# ------------------------------------------------------------
SNOWFLAKE_ACCOUNT=CHANGE-ME
SNOWFLAKE_USER=CHANGE-ME
SNOWFLAKE_ROLE=TRANSFORM
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SHOPANALYSIS
SNOWFLAKE_SCHEMA=DEV

# ------------------------------------------------------------
# DuckDB - Permanent local portfolio warehouse
# ------------------------------------------------------------
DUCKDB_PATH=data/shopanalysis.duckdb

# ------------------------------------------------------------
# Garage - Permanent local S3-compatible object storage
# ------------------------------------------------------------
# Generate GARAGE_RPC_SECRET locally as a 64-character
# hexadecimal value. Never commit the real secret.
GARAGE_RPC_SECRET=CHANGE-ME

GARAGE_ENDPOINT=http://localhost:3900
GARAGE_REGION=garage
GARAGE_BUCKET=shopanalysis-raw

# Created locally with:
# garage key create shopanalysis-app
# Never commit real application credentials.
GARAGE_ACCESS_KEY_ID=CHANGE-ME
GARAGE_SECRET_ACCESS_KEY=CHANGE-ME

# ------------------------------------------------------------
# Apache Airflow
# ------------------------------------------------------------
AIRFLOW_HOME=./orchestration
